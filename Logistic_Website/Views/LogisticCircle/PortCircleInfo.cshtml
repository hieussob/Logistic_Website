</div>
<script>
        document.addEventListener("DOMContentLoaded", function () {
        // Căn chiều cao button theo label
        const buttons = document.querySelectorAll('.match-height-btn');
        const label = document.getElementById('header-label');

        if (label && buttons.length > 0) {
            const labelHeight = label.offsetHeight;
            buttons.forEach(button => {
                button.style.height = `${labelHeight}px`;
            });
        }

        // Sự kiện click nút chuyển nội dung
        buttons.forEach(btn => {
            btn.addEventListener('click', function () {
                const url = this.getAttribute('data-action-url');
                fetchContent(url, this);
            });
        });


        function fetchContent(url, btn) {
            fetch(url)
                .then(res => res.text())
                .then(html => {
                    document.getElementById("main-content").innerHTML = html;
                    buttons.forEach(b => b.classList.remove('active', 'fw-bold'));
                    btn.classList.add('active', 'fw-bold');
                    initSearchReviewScript();
                })
                .catch(err => console.error("Error loading content:", err));
        }

        function initSearchReviewScript() {
        const searchBtn = document.getElementById("searchReviewButton");
        const searchInput = document.getElementById("searchReviewInput");

        if (searchBtn && searchInput) {
            searchBtn.addEventListener("click", function () {
                const value = searchInput.value;
                console.log("Searching for:", value);

                fetch("@Url.Action("SearchReview", "LogisticCircle")", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(value)
                })
                .then(response => response.text())
                .then(data => {
                    document.getElementById("searchReviewResults").innerHTML = data;
                })
                .catch(err => console.error("Search error:", err));
            });
        }
    }

    });

</script>

<style>
    .selectable-btn {
        background-color: #f0f0f0;
        color: black;
